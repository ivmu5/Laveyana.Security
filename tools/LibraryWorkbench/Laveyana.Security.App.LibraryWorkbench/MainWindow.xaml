<Window x:Class="Laveyana.Security.App.LibraryWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laveyana.Security · LibraryWorkbench" Width="1300" Height="830"
        Background="{DynamicResource PageBrush}"
        MinWidth="950" MinHeight="640" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="172"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="18,13" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ThemeButton" Content="Светлая тема" Click="ThemeClick" />
                    <Button Content="Сохранить журнал" Click="SaveLogClick" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Library Workbench" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Laveyana.Security  /  интерактивный обозреватель и лаборатория"
                               Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="ТИПЫ И ИНТЕРФЕЙСЫ" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,10" />
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Поиск по имени, namespace, сборке или типу" Margin="0,0,0,10" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding FilteredTypes}" SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="TypeSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="1,2">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="10" />
                                        <TextBlock Text="  ·  " Foreground="{DynamicResource MutedBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding Group}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" />
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Открыть исходник" Click="OpenSourceClick" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Right" />
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedTitle}" FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedSubtitle}" Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <TabControl Grid.Row="1" x:Name="DetailsTabs" Margin="0,1,0,0">
                        <TabItem Header="Обзор">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="15">
                                    <TextBlock Text="ПОЛНОЕ ИМЯ ТИПА" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding SelectedDescription}" Margin="0,0,0,20"/>
                                    <TextBlock Text="СВЯЗИ И МЕТАДАННЫЕ" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Relationships}" FontFamily="Consolas" FontSize="12"/>
                                    <TextBlock Margin="0,25,0,0" Foreground="{DynamicResource MutedBrush}"
                                               Text="Типы обнаруживаются автоматически. Выполнение незарегистрированных методов всегда заблокировано."/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Методы">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="MethodList" Grid.Column="0" ItemsSource="{Binding Methods}"
                                         SelectionChanged="MethodSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Signature}" FontSize="11"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12,2,4,12">
                                        <TextBlock Text="ФОРМА ПАРАМЕТРОВ" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="MethodTitle" Text="Выберите метод в списке." TextWrapping="Wrap"
                                                   FontFamily="Consolas" Margin="0,0,0,14" />
                                        <StackPanel x:Name="GeneratedParameterPanel" />
                                        <TextBlock x:Name="MethodHint" Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,10,0,12" />
                                        <Button x:Name="ExecuteMethodButton" Content="Выполнить разрешённый метод" Style="{StaticResource PrimaryButtonStyle}"
                                                HorizontalAlignment="Left" IsEnabled="False" Click="ExecuteMethodClick" />
                                        <TextBlock x:Name="MethodOutput" TextWrapping="Wrap" Margin="0,12,0,0" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Эксперименты">
                            <ScrollViewer>
                                <StackPanel Margin="10">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,0,0,12" Text="Сценарии вызывают настоящие API. Только синтетические данные; production-секреты запрещены." />
                                    <ContentControl x:Name="CustomViewHost" />
                                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="0,14,0,0"
                                            Padding="15">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" FontSize="15" Text="Отдельный worker-процесс" />
                                            <TextBlock Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,10"
                                                       Text="Worker запускается для проверок с синтетическими данными. Это не OS-песочница." />
                                            <WrapPanel>
                                                <Button Content="Worker · SHA-256" Click="WorkerCryptoClick" />
                                                <Button Content="Worker · временный файл" Click="WorkerFileClick" />
                                            </WrapPanel>
                                            <TextBlock x:Name="WorkerResult" TextWrapping="Wrap" Margin="0,12,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,9">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ЖУРНАЛ СОБЫТИЙ" FontWeight="Bold" FontSize="11"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />
                <ListBox ItemsSource="{Binding Logs}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="{Binding Time}" Foreground="{DynamicResource MutedBrush}"
                                           FontFamily="Consolas" Margin="0,0,11,0" />
                                <TextBlock Text="{Binding Level}" Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="SemiBold" Width="64" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <DockPanel Grid.Row="3">
            <TextBlock DockPanel.Dock="Right" Text="EXPERIMENTAL / TEST ONLY  ·  Phase 27 NO-GO"
                       Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
