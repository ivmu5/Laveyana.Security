<UserControl x:Class="Laveyana.Security.App.LibraryWorkbench.Views.LocalCryptographyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="7" MaxWidth="780" HorizontalAlignment="Left">
            <TextBlock FontSize="19" FontWeight="SemiBold" Text="LocalCryptography · живая демонстрация" />
            <TextBlock Margin="0,6,0,18" Foreground="{DynamicResource MutedBrush}"
                       Text="Здесь выполняются настоящие методы библиотеки. Используй только синтетический текст, не вводи пароли и секреты." />
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="17" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="SHA-256" FontSize="15" />
                    <TextBlock Margin="0,7,0,8" Foreground="{DynamicResource MutedBrush}"
                               Text="Хешируем текст через LocalCryptography.Sha256(...)" />
                    <TextBox x:Name="InputText" Width="480" MaxWidth="480" HorizontalAlignment="Left"
                             Text="Synthetic demo message" />
                    <Button Margin="0,12,0,0" Width="150" HorizontalAlignment="Left" Content="Рассчитать SHA-256"
                            Click="HashClick" Style="{StaticResource PrimaryButtonStyle}" />
                    <TextBox x:Name="HashOutput" Margin="0,9,0,0" Width="480" MaxWidth="480" HorizontalAlignment="Left"
                             IsReadOnly="True" TextWrapping="Wrap" Background="{DynamicResource ReadOnlyBrush}" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="17">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" FontSize="15" Text="HMAC-SHA-256" />
                    <TextBlock Margin="0,7,0,9" Foreground="{DynamicResource MutedBrush}"
                               Text="Генерируем одноразовый ключ в памяти, вычисляем и проверяем тег. Ключ не показываем и очищаем." />
                    <Button Width="185" HorizontalAlignment="Left" Content="Проверить HMAC" Click="HmacClick" Style="{StaticResource PrimaryButtonStyle}" />
                    <TextBlock x:Name="HmacOutput" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
